rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Classes and student portal data
    match /classes/{classId} {
      allow read, write: if true;

      match /tasks/{taskId} {
        allow read, write: if true;
      }

      match /schedules/{scheduleId} {
        allow read, write: if true;
      }
    }

    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
